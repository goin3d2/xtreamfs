# Copy this file to .env and fill it in.

# Provider details: the same server, username and password your IPTV player uses.
# You can leave these out and enter them on the settings page (port 8099) instead.
XTREAM_URL=http://provider.example.com:8080
XTREAM_USER=your_username
XTREAM_PASS=your_password

# Categories to include, comma-separated. Use IDs or exact names, or "all" for
# every category (including ones the provider adds later).
# Find them with:  docker compose run --rm xtreamfs --list-categories
MOVIE_CATEGORIES=
SERIES_CATEGORIES=
# Categories to leave out when using "all" (IDs or names).
MOVIE_EXCLUDE=
SERIES_EXCLUDE=

# Optional: give categories their own top-level folder (and Plex library).
# Format: ID or name=Folder name, comma-separated, e.g. Crunchyroll=Anime. Mapped categories are included
# automatically.
SERIES_FOLDERS=
MOVIE_FOLDERS=

# Optional: send individual titles to a folder by TMDB ID.
# Format: id,id=Folder;id,id=Other folder
SERIES_OVERRIDES=
MOVIE_OVERRIDES=

# 1 = one subfolder per provider category under Movies (Movies/<Category>/...).
MOVIE_CATEGORY_FOLDERS=0

# 1 = one subfolder per provider category under TV (TV/<Category>/...).
# TV libraries treat folders directly under TV as shows, so with this on, add
# each category folder to the library separately. Usually best left at 0.
SERIES_CATEGORY_FOLDERS=0

# Also write a .strm copy of the whole library here (for Emby/Jellyfin).
# /strm is the ./strm folder next to docker-compose.yml. Leave empty to turn off.
STRM_DIR=

# The .strm folder as Emby sees it (often different from /strm inside this container).
# Written into config/categories.json so Emby Collections can match titles by path.
# Empty = same as STRM_DIR.
EMBY_STRM_PATH=

# 0 = no FUSE mount, only the .strm copy (Emby/Jellyfin without Plex).
# docker-compose.emby.yml sets this for you.
MOUNT=1

# 1 = also write .nfo metadata files (plot, cast, genres, ratings, artwork links)
# next to the .strm files, from the provider's catalog, so Emby/Jellyfin can fill
# in new titles without looking each one up online.
STRM_NFO=0

# 1 = mark those .nfo files locked, so Emby/Jellyfin keep the provider's details
# and skip online lookups for these titles even with metadata downloaders on.
STRM_NFO_LOCK=0

# 1 = fetch each movie's full details from the provider (plot, genres, cast,
# runtime, backdrop...), one request per film, cached in movie_details.json, and
# write them into the movies' .nfo files. The first run takes a few hours on a
# big catalog; later refreshes only fetch new movies.
MOVIE_DETAILS=0

# 1 = download each movie's poster and backdrop into its folder (poster.jpg,
# fanart.jpg), about 250 KB per movie.
MOVIE_ARTWORK=0

# 1 = put each show's theme song (theme.mp3, from Plex's theme server) in its
# .strm folder, so Emby/Jellyfin play it while browsing. Needs TMDB_API_KEY.
SERIES_THEMES=0
# TMDB v3 API key or v4 read access token, used to find shows' TVDB ids.
TMDB_API_KEY=
# Shows looked up for a theme per sync, and days before a miss is tried again.
THEME_LOOKUPS=500
THEME_RETRY_DAYS=30

# Keep the previous catalog if a refresh would remove more than this share of
# movies or shows (0 turns the check off).
SHRINK_GUARD_PERCENT=25

# Simultaneous connections to the provider. Set to your plan's limit,
# minus any you need for live TV or other devices.
MAX_STREAMS=1

# How often to re-read the catalog for new and removed titles.
REFRESH_HOURS=12

# Remove provider tags like "EN - " or "|EN|" from titles (1 = yes).
STRIP_PREFIX=1

# Pause between catalog API calls, in seconds, to go easy on the provider.
API_DELAY=0.3

# Some providers only accept known player user agents.
USER_AGENT=VLC/3.0.20 LibVLC/3.0.20

LOG_LEVEL=INFO

# Settings and status page (http://<server>:8099). 0 turns it off.
WEB_PORT=8099
# Optional password for the page (any username). Leave empty for none.
WEB_PASSWORD=
