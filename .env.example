# Copy this file to .env and fill it in.

# Provider details: the same server, username and password your Emby plugin uses.
XTREAM_URL=http://provider.example.com:8080
XTREAM_USER=your_username
XTREAM_PASS=your_password

# Categories to include, comma-separated. Use IDs or exact names.
# Find them with:  docker compose run --rm xtreamfs --list-categories
MOVIE_CATEGORIES=
SERIES_CATEGORIES=

# Optional: give categories their own top-level folder (and Plex library).
# Format: ID=Folder name, comma-separated. Mapped categories are included
# automatically.
SERIES_FOLDERS=
MOVIE_FOLDERS=

# Optional: send individual titles to a folder by TMDB ID.
# Format: id,id=Folder;id,id=Other folder
SERIES_OVERRIDES=
MOVIE_OVERRIDES=

# Simultaneous connections to the provider. Set to your plan's limit,
# minus any you need for live TV or other devices.
MAX_STREAMS=1

# How often to re-read the catalog for new and removed titles.
REFRESH_HOURS=12

# Remove provider tags like "EN - " or "|EN|" from titles (1 = yes).
STRIP_PREFIX=1

# Pause between catalog API calls, in seconds, to go easy on the provider.
API_DELAY=0.3

# Some providers only accept known player user agents.
USER_AGENT=VLC/3.0.20 LibVLC/3.0.20

LOG_LEVEL=INFO
